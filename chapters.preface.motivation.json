{"version":3,"kind":"Article","sha256":"27a6682fbe09084f8030218a6cfe101c08f143d4d5e6b2e67e89cb57f31c8c22","slug":"chapters.preface.motivation","location":"/chapters/preface/motivation.md","dependencies":[],"frontmatter":{"title":"Motivation","numbering":{"title":{"enabled":true,"offset":1},"equation":{"enabled":true,"continue":true},"heading_1":{"enabled":false},"heading_2":{"enabled":false},"heading_3":{"enabled":false},"heading_4":{"enabled":false},"heading_5":{"enabled":false},"heading_6":{"enabled":false}},"content_includes_title":false,"keywords":["python","chemistry"],"exports":[{"format":"md","filename":"motivation.md","url":"/python_for_chemists/build/motivation-34c542a6d596bf7022c718927e79bcf9.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Warum sollte ich im Chemie-Studium programmieren lernen?","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"OgjnOxXZFj"}],"key":"oB29aIWhHL"}],"key":"Y1p4g6Eejo"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Programmieren ist in vielen Bereichen der Chemie ein wichtiges Werkzeug, nicht nur in der physikalischen oder theoretischen Chemie. Auch in der Synthese, Analytik oder Biochemie hilft es dabei, Daten auszuwerten, Abläufe zu automatisieren und Ergebnisse systematisch zu dokumentieren. Wer programmieren kann, arbeitet effizienter und kann moderne chemische Methoden besser nutzen und verstehen.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"krjmYiOYwt"}],"key":"pMl23Fw1D3"},{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"strong","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"Warum lernen wir die Programmiersprache Python?","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"S43ATytkAx"}],"key":"TLmU8cEFzz"}],"key":"kj4eeM3Q0E"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Python ist leicht zu lesen, gut für Einsteiger geeignet und zugleich in den Naturwissenschaften weit verbreitet. Mit Bibliotheken wie NumPy, SciPy oder Matplotlib lassen sich Berechnungen, Datenanalyse und Visualisierung direkt umsetzen. Dadurch eignet sich Python besonders gut für einen praktischen Einstieg in wissenschaftliches Programmieren.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"BZzPqUvIqP"}],"key":"EWgXQ2d6Ul"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"strong","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Warum ist das Vorlesungsskript auf Englisch?","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"KrHqSxy3lf"}],"key":"b0x6S2i5cz"}],"key":"cfOmOgMqXZ"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Englisch ist die wichtigste Sprache in Forschung, Fachliteratur und Software-Dokumentation. Ein englisches Skript hilft Ihnen deshalb, sich früh an die Begriffe und Ausdrucksweisen der wissenschaftlichen Praxis zu gewöhnen. Die Vorlesung selbst findet weiterhin auf Deutsch statt.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"deg3uVZowB"}],"key":"vWpqXMJbg0"}],"key":"q8VyhVo33d"}],"key":"qoeHjGlE2O"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Vorwort","url":"/chapters/preface","group":"Programmierkurs für Chemiker"},"next":{"